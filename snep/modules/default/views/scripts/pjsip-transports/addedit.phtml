<script type="text/javascript">
// TASK-0029A: progressive disclosure -- TLS/certificate fields are
// irrelevant noise for udp/tcp (Snep_PjsipTransportConf never emits
// them for those protocols; the controller rejects them being set at
// all), and verify_server/method are additionally inert for wss/ws
// (real TLS control for those lives in http.conf, confirmed live --
// see docs/tasks/0029a-tls-transport-certificate-management.md).
function senmaTransportShowTls() {
    var protocol = document.getElementById("transport_protocol").value;
    var tlsCapable = (protocol === "tls" || protocol === "wss" || protocol === "ws");
    document.getElementById("transport_tls_group").className = tlsCapable ? "visible" : "invisible";
    var tlsOnly = (protocol === "tls");
    document.getElementById("transport_verify_server_group").className = tlsOnly ? "visible" : "invisible";
    document.getElementById("transport_method_group").className = tlsOnly ? "visible" : "invisible";
}
senmaTransportShowTls();
</script>
