<div class= "row">
  <div class="tab-content">
    <div class="tab-pane active" id="demo">
      <?php if($this->options != 'all'){ ?>
        <div id="carousel-notifications" class="carousel slide" data-ride="carousel" data-interval="false">
          <div class='carousel-inner'>
            <?php foreach($this->html as $key => $html):
              echo $html;
            endforeach; ?>
          </div>
        </div>
        <?php if (isset($this->notificationId) && $this->notificationId !== null && $this->notificationId !== ''): ?>
        <script type="text/javascript">
        // TASK-0026G (Phase 11 follow-up): viewing a single notification
        // (this branch) still marks it read, exactly as before -- just
        // via a CSRF-protected POST (includes/javascript/csrf.js attaches
        // the token automatically) instead of as a side effect of this
        // page's own GET.
        jQuery(function($) {
          $.post('<?php echo $this->baseUrl(); ?>/index.php/default/notifications/mark-read', {
            id: <?php echo json_encode((string) $this->notificationId); ?>
          });
        });
        </script>
        <?php endif; ?>
      <?php }else{ ?>
        <table class="table table-striped" id="listtable">
          <thead>
            <tr>
              <th><?php echo $this->translate('Sender');?></th>
              <th><?php echo $this->translate('Notification');?></th>
              <th data-sort-ignore="true"><?php echo $this->translate('Date');?></th>
              <th class="text-center"><?php echo $this->translate('Actions');?></th>
            </tr>
          </thead>
          <tbody>
            <?php if( $this->notifications ) :
              foreach ($this->notifications as $key => $notification):
                if(!@$notification->id && $notification->_id){
                  $notification->id = $notification->_id;
                }?>
                <?php
                  // TASK-0025: from/title/message are vendor-controlled
                  // (Snep_Notifications::getAll(), TASK-0024-cached but
                  // still untrusted -- see
                  // docs/tasks/0025-vendor-content-xss-hardening.md §3/§7).
                  // Escape at this exact output boundary: text nodes via
                  // $this->escape() (htmlspecialchars, matches this
                  // view's own established pattern elsewhere in the
                  // app), and truncate (substr) BEFORE escaping so a
                  // multi-byte/entity boundary is never split mid-entity.
                  // id is escaped too, even though it is normally
                  // numeric (core_notifications.id_itc is int(11)) --
                  // escaping at output never assumes a upstream type
                  // guarantee holds.
                  $notif_from = $this->escape((string) ($notification->from ?? ''));
                  $notif_title = $this->escape((string) ($notification->title ?? ''));
                  $notif_message = $this->escape(substr((string) ($notification->message ?? ''), 0, 30)) . '...';
                  $notif_id = $this->escape((string) ($notification->id ?? ''));
                ?>
                <tr>
                  <?php if($notification->status == 'read'){?>
                    <td> <?php echo $notif_from ?> </td>
                    <td> <?php echo $notif_title ." - ". $notif_message ?> </td>
                    <td> <?php echo date("d/m/Y G:i:s", strtotime($notification->creation_date)) ?> </td>
                  <?php }else{?>
                    <td class="bold"> <?php echo $notif_from ?> </td>
                    <td class="bold"> <?php echo $notif_title ." - ". $notif_message ?> </td>
                    <td class="bold"> <?php echo date("d/m/Y G:i:s", strtotime($notification->creation_date)) ?> </td>
                  <?php } ?>
                    <td class="text-center">
                      <a class="btn btn-add btn-sm"  href="<?php echo $this->url ?>?id=<?php echo $notif_id ?>" role="button"><?php echo $this->translate('Click to visualize')?></a>
                      <a class="btn btn-danger btn-sm" href="<?php echo $this->url ?>/remove/id/<?php echo $notif_id ?>" role="button"><?php echo $this->translate('Delete')?></a>
                    </td>
                  </tr>
                <?php endforeach ?>
              <?php endif?>
            </tbody>
          </table>
        <?php } ?>
        <br>
      </div>
    </div>
</div>

<script type="text/javascript">

jQuery.noConflict();

jQuery(document).ready(function() {
  jQuery('#listtable').dataTable( {
    "pageLength": <?php echo $this->lineNumber ?>,
    "oLanguage": {
      "sUrl": "<?php echo $this->baseUrl(); ?>/includes/javascript/datatables/media/language/pt-BR.json"
    },
    "bLengthChange": false,
  });
});
</script>
