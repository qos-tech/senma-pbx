        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label"><?php echo $this->translate("External Media Address");?></label>
        <div class="col-sm-6">
          <input type="text" class="form-control" name="external_media_address" value='<?php echo $this->escape($this->transport['external_media_address']);?>'/>
        </div>
      </div>

