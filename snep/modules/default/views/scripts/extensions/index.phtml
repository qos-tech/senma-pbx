                        // Snep_PjsipStatus_Manager. Legacy chan_sip/IAX
                        // extensions get no runtime_status (null); shown
                        // as a plain dash, not a fabricated state. ?>
                  <td class="text-center" data-runtime-status="<?php echo $val['runtime_status'] ? $this->escape($val['runtime_status']['state']) : ''; ?>">
                    <?php // TASK-0032 (Phase 5): shared status badge
                          // primitive, replacing this view's own copy of
                          // the class/label maps (Snep_View_Helper_StatusBadge). ?>
                    <?php echo $this->statusBadge($val['runtime_status'] ? $val['runtime_status']['state'] : null, array('detail' => $val['runtime_status'] ? $val['runtime_status']['detail'] : null)); ?>
                  </td>
                  <td class="text-center">
                    <a class="btn btn-edit btn-sm" href='<?php echo $this->url ?>/edit/id/<?php echo $val['exten'] ?>' role="button"><?php echo $this->translate('Edit')?></a>
                    <a class="btn btn-danger btn-sm"  href='<?php echo $this->url ?>/remove/id/<?php echo $val['exten'] ?>'><?php echo $this->translate('Delete')?></a>
                    <?php if ($val['disabled'] == false) { ?>
                      <a class="btn btn-info btn-sm"  href='<?php echo $this->url ?>/disable/id/<?php echo $val['exten'] ?>'><?php echo $this->translate('Disable')?></a>
                    <?php }else{ ?>
                      <a class="btn btn-primary btn-sm"  href='<?php echo $this->url ?>/enable/id/<?php echo $val['exten'] ?>'><?php echo $this->translate('Enable')?></a>
