          <select class="form-control" name="protocol">
            <?php foreach (array('udp', 'tcp', 'tls', 'wss', 'ws') as $proto): ?>
              <option value="<?php echo $proto; ?>" <?php echo ($this->transport['protocol'] === $proto) ? "selected" : ""; ?>><?php echo strtoupper($proto); ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label"><?php echo $this->translate("Bind Address");?></label>
        <div class="col-sm-4">
