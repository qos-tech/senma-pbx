              // unchanged, still set by
              // ExtensionsController::reportSaveResult()/removeAction()
              // (TASK-0031/TASK-0032) -- never a bare 302 implying
              // success. ?>
        <?php echo $this->applyFeedback(array(
          'saved_active' => $this->saved_active_messages,
          'saved_pending' => $this->saved_pending_messages,
          'apply_failed' => $this->apply_failed_messages,
          'deleted' => $this->deleted_messages,
        )); ?>
          <table class="table table-striped" id="listtable">
            <thead>
              <tr>
                <th class="text-center"><?php echo $this->translate('Extension');?></th>
                <th class="text-center"><?php echo $this->translate('Caller ID');?></th>
                <!-- TASK-0031 (Phase 14): Channel/Extension Group are the
                     lowest-priority columns on this table -- collapsed
                     first at narrow widths rather than forcing horizontal
                     scroll for every column. -->
                <th class="text-center hidden-xs hidden-sm"><?php echo $this->translate('Channel');?></th>
                <th class="text-center hidden-xs"><?php echo $this->translate('Extension Group');?></th>
                <th class="text-center"><?php echo $this->translate('Status');?></th>
