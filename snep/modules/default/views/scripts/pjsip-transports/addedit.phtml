<script type="text/javascript">
// TASK-0032 (Phase 11): progressive disclosure now toggles the native
// `hidden` attribute (+ mirrors it onto aria-hidden) instead of swapping
// a visible/invisible CSS class -- TASK-0030's own accessibility finding
// was that a JS-driven className toggle may still leave a visually-absent
// field announced by assistive technology. Server-rendered initial state
// (see $tlsCapable/$tlsOnly above) means a client with JS disabled still
// sees the CORRECT fields for whatever protocol was already saved.
function senmaSetHidden(id, isHidden) {
    var el = document.getElementById(id);
    if (!el) { return; }
    el.hidden = isHidden;
    el.setAttribute("aria-hidden", isHidden ? "true" : "false");
}
function senmaTransportShowTls() {
    var protocol = document.getElementById("transport_protocol").value;
    var tlsCapable = (protocol === "tls" || protocol === "wss" || protocol === "ws");
    senmaSetHidden("transport_tls_group", !tlsCapable);
    var tlsOnly = (protocol === "tls");
    senmaSetHidden("transport_verify_server_group", !tlsOnly);
    senmaSetHidden("transport_method_group", !tlsOnly);
}
senmaTransportShowTls();
</script>
