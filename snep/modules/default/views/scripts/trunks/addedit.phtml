<script type="text/javascript">

jQuery.noConflict();

function applyConnectionType(type){
  var isExternal = (type === 'external');
  document.getElementById('technology').value = isExternal ? 'pjsip_external' : 'pjsip';
  document.getElementById('reverse_auth_hidden').value = (type === 'registered') ? 'reverse_auth' : '';

  document.getElementById('panel-external').className = isExternal ? 'visible' : 'invisible';
  document.getElementById('panel-provider').className = isExternal ? 'invisible' : 'visible';
  document.getElementById('panel-pjsip-only').className = isExternal ? 'invisible' : 'visible';

  var showCredentials = (type === 'registered' || type === 'unregistered');
  document.getElementById('panel-credentials').className = showCredentials ? 'visible' : 'invisible';
  if (!showCredentials && !isExternal) {
    // TASK-0031 (Phase 7): switching to IP-authenticated means the
    // admin no longer intends credentials to be used -- clearing them
    // (rather than merely hiding) keeps the saved configuration honest
    // about that choice instead of silently persisting stale values.
    document.getElementById('username').value = '';
    document.getElementById('secret').value = '';
  }
}

window.onload = function(){
  var selected = document.querySelector('input[name="connection_type"]:checked');
  applyConnectionType(selected ? selected.value : (document.getElementById('technology').value === 'pjsip_external' ? 'external' : 'registered'));

  jQuery("#minute_control_div").hide();
  jQuery("#closing_date_div").hide();
  var time = "<?php echo $this->tempo; ?>";
  if(time == 'checked'){
    jQuery("#minute_control_div").show();
    var chargeby_M = "<?php echo $this->chargeby_M; ?>";
    if(chargeby_M == 'checked'){
      jQuery("#closing_date_div").show();
    }
  }
}

function showMinuteControl(){
  if(document.getElementById('tempo').checked) {
    jQuery("#minute_control_div").show();
  } else {
    jQuery("#minute_control_div").hide();
  }
}

function showMinuteControlRadio(){
  var condition = jQuery('input:radio[name=time_chargeby]:checked').val();
  if(condition == 'M'){
    jQuery("#closing_date_div").show();
  }else{
    jQuery("#closing_date_div").hide();
  }
}

jQuery(document).ready(function(){
  jQuery('#defaultForm').validate({
    rules: {
      callerid: {
        required: true,
        minlength: 5,
        maxlength: 30
      },
      host: {
        required: function() {
          return document.getElementById('technology').value !== 'pjsip_external';
        }
      },
      external_endpoint: {
        required: function() {
          return document.getElementById('technology').value === 'pjsip_external';
        }
      },
      dtmf_dial_number: {
        required: function() {
          return jQuery("#dtmf_dial").is(":checked");
        }
      },
      time_total: {
        required: function() {
          return jQuery("#tempo").is(":checked");
        },
        numbersOnly: true
      }
    },
    messages: {
      callerid: {
        required: "<?php echo $this->translate('The name is required'); ?>",
        minlength: "<?php echo $this->translate('Please enter at least {0} characters.'); ?>",
        maxlength: "<?php echo $this->translate('Please enter no more than {0} characters.'); ?>"
      }
    },
    highlight: function(element) {
      jQuery(element).closest('.control-group').removeClass('success').addClass('error');
    },
    success: function(element) {
      element
      .text('OK!').addClass('valid')
      .closest('.control-group').removeClass('error').addClass('success');
    }
  });
});
jQuery(function() {

  jQuery('#secret').password().on('show.bs.password', function(e) {
    jQuery('#methods').prop('checked', true);
  }).on('hide.bs.password', function(e) {
    jQuery('#methods').prop('checked', false);
  });
  jQuery('#methods').click(function() {
    jQuery('#secret').password('toggle');
  });
});

</script>
