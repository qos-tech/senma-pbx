<div class= "row">
  <div class="tab-content">
    <div class="tab-pane active" id="demo">
      <div class="panel panel-default">
        <?php if ($this->alert_message): ?>
          <div class="alert alert-warning"><?php echo $this->alert_message; ?></div>
        <?php endif; ?>
        <?php // TASK-0032 (Phase 10): runtime unavailability is a distinct,
              // explicit banner -- never silently rendered as "no
              // transports configured" when DB data exists but the AMI
              // query itself failed. See
              // PjsipTransportsController::indexAction(). ?>
        <?php if ($this->runtimeQueryFailed): ?>
          <div class="alert alert-warning"><?php echo $this->translate("Asterisk's live transport state could not be queried right now. The configuration below is accurate; Status columns show Unknown until this is resolved.");?></div>
        <?php endif; ?>
        <?php // TASK-0032 (Phase 6): one shared save/apply feedback
              // primitive, replacing the two hand-duplicated foreach
              // blocks this view used to render directly (see
              // Snep_View_Helper_ApplyFeedback). Transports only ever
              // produce these two outcomes -- never saved_active/
              // saved_pending, which have no meaning for a transport
              // (TASK-0020). ?>
        <?php echo $this->applyFeedback(array(
          'restart_required' => $this->restart_required_messages,
          'apply_failed' => $this->apply_failed_messages,
        )); ?>
        <div class="panel-heading">
          <div class="snep-body-top-buttons">
            <a class="btn btn-add" href="<?php echo $this->url ?>/add/ " role="button"><?php echo $this->translate("Add Transport")?></a>
            <div class="snep-body-search">
              <?php if($this->key){ ?>
                <a class='sn-dash-add' href="<?php echo $this->baseUrl(); ?>/default/index/index?dashboard_add=<?php echo $this->key ?>" title="<?php echo $this->translate('Add to dashboard');?>"></a>
              <?php } ?>
            </div>
          </div>
        </div><br>
        <?php if (count($this->transports) === 0 && !$this->runtimeQueryFailed): ?>
          <p class="text-muted" style="padding: 0 15px 15px;"><?php echo $this->translate("No transports configured yet.");?></p>
        <?php else: ?>
        <table class="table table-striped" id="listtable">
          <thead>
            <tr>
              <!-- TASK-0032 (Phase 12): Name/Protocol/Bind/Status/Actions
                   are the high-priority columns for this table -- External
                   Signaling/External Media/In Use collapse first at
                   narrow widths, matching the exact hidden-xs/hidden-sm
                   utility-class pattern TASK-0031 already established for
                   Extensions/Trunks (no footable dependency). -->
              <th class="text-center"><?php echo $this->translate('Name');?></th>
              <th class="text-center"><?php echo $this->translate('Protocol');?></th>
              <th class="text-center"><?php echo $this->translate('Bind');?></th>
              <th class="text-center hidden-xs hidden-sm"><?php echo $this->translate('External Signaling');?></th>
              <th class="text-center hidden-xs hidden-sm"><?php echo $this->translate('External Media');?></th>
              <th class="text-center"><?php echo $this->translate('Status');?></th>
              <th class="text-center hidden-xs"><?php echo $this->translate('In Use');?></th>
              <th class="text-center"><?php echo $this->translate('Actions');?></th>
            </tr>
          </thead>
          <tbody>
            <?php foreach($this->transports as $transport): ?>
              <tr>
                <td class="text-center">
                  <?php echo $transport['name'] ?>
                  <?php if ($transport['is_default']): ?>
                    <span class="label label-info"><?php echo $this->translate('default')?></span>
                  <?php endif ?>
                </td>
                <td class="text-center"><?php echo strtoupper($transport['protocol']) ?></td>
                <td class="text-center"><?php echo $transport['bind_address'] . ':' . $transport['bind_port'] ?></td>
                <td class="text-center hidden-xs hidden-sm">
                  <?php echo $transport['external_signaling_address'] ? $transport['external_signaling_address'] . ($transport['external_signaling_port'] ? ':' . $transport['external_signaling_port'] : '') : '-' ?>
                </td>
                <td class="text-center hidden-xs hidden-sm"><?php echo $transport['external_media_address'] ?: '-' ?></td>
                <?php // TASK-0032 (Phase 4/5): ONE shared status badge,
                      // replacing the separate Status (enabled/disabled)
                      // and Runtime (active/restart_required) columns this
                      // view used to render as two independently-styled
                      // blocks. data-runtime-state is preserved verbatim
                      // (scripts/transport-smoke-test.sh's own
                      // t20_runtime_badge() depends on this exact
                      // attribute/value set, TASK-0020) alongside the new
                      // shared data-runtime-status attribute extensions/
                      // trunks already carry. ?>
                <td class="text-center"
                    data-runtime-state="<?php echo $this->escape($transport['runtime_state']); ?>"
                    data-runtime-status="<?php echo $this->escape($transport['status']['state']); ?>">
                  <?php echo $this->statusBadge($transport['status']['state'], array('detail' => $transport['status']['detail'])); ?>
                </td>
                <td class="text-center hidden-xs"><?php echo (int) $transport['usage_count'] ?></td>
                <td class="text-center">
                  <a class="btn btn-edit btn-sm" href="<?php echo $this->url ."/edit/id/".  $transport['id'] ?>" role="button"><?php echo $this->translate('Edit')?></a>
                  <a class="btn btn-danger btn-sm" href="<?php echo $this->url ."/remove/id/".  $transport['id'] ?>" role="button"><?php echo $this->translate('Delete')?></a>
                </td>
              </tr>
            <?php endforeach ?>
          </tbody>
        </table>
        <?php endif; ?>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">

jQuery.noConflict();

jQuery(document).ready(function() {
  jQuery('#listtable').dataTable( {
    "pageLength": <?php echo $this->lineNumber ?>,
    "oLanguage": {
      "sUrl": "<?php echo $this->baseUrl(); ?>/includes/javascript/datatables/media/language/pt-BR.json"
    },
    "bLengthChange": false,
  });
});
</script>
