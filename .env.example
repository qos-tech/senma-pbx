# TASK-0034: every `change-*-for-local-development` value below is a
# development-only placeholder, intentionally not a plausible production
# secret. Before any production/pilot deployment, generate and set real
# values for DB_PASSWORD, DB_ROOT_PASSWORD, AMI_PASSWORD, and (if the
# `provider` fixture is not part of the deployment) remove
# TRUNK_TEST_USERNAME/TRUNK_TEST_SECRET. Never deploy this file's
# defaults as-is. See docs/operations/production-release-runbook.md.
COMPOSE_PROJECT_NAME=mag-pbx
MAG_HTTP_PORT=8080
DB_HOST=db
DB_PORT=3306
DB_NAME=snep
DB_USER=snep
DB_PASSWORD=change-me-for-local-development
DB_ROOT_PASSWORD=change-root-for-local-development
TZ=America/Sao_Paulo

# TASK-0005: Asterisk container / AMI. AMI_USER/AMI_PASSWORD are used both
# to template asterisk's manager.conf and SENMA's setup.conf -- they must
# match on both sides, which the entrypoints achieve by sourcing the same
# env vars, not by copying a value into two places by hand.
ASTERISK_HOST=asterisk
AMI_USER=snep
AMI_PASSWORD=change-me-for-local-development
# Must match the `mag` network's pinned subnet in compose.yaml -- do not
# assume Docker's default bridge subnet (172.17.0.0/16); it is not this
# project's actual network.
ASTERISK_AMI_ACL_SUBNET=172.28.0.0/16

# TASK-0012: application web base URL (distinct from the container
# filesystem path, /var/www/html/snep, which never changes). Leave empty
# for this project's default Docker deployment (SENMA served at the web
# root, "/"). Only set this (e.g. "/snep" -- leading slash, no trailing
# slash) if this specific deployment genuinely serves SENMA from a
# subdirectory of a shared web root. See
# docs/tasks/0012-web-base-path-cleanup.md.
SENMA_WEB_BASE_PATH=

# TASK-0026G: the session cookie's Secure attribute is enabled whenever a
# request is actually HTTPS (checked directly). This project's current
# Docker topology (compose.yaml) has no reverse proxy in front of the app
# container -- leave this unset/false for that default deployment. Only
# set to "1" if a deployment adds a TRUSTED reverse proxy in front of the
# app that itself sets (and cannot be made to lie about)
# X-Forwarded-Proto -- otherwise this header is attacker-controllable and
# enabling this would make Secure trivially bypassable. See
# docs/tasks/0026g-session-cookie-csrf-hardening.md.
SENMA_TRUST_PROXY_HTTPS=

# TASK-0034E: the authoritative public hostname pilot/production WSS
# clients connect to and validate the WSS certificate's SAN against
# (docs/tasks/0034e-production-wss-certificate-trust-runtime-verification.md
# HOSTNAME CONTRACT). Leave empty for local development -- `make
# cert-check`/`make doctor` then skip hostname/SAN validation explicitly
# rather than guessing. REQUIRED before a pilot go-live with WSS in
# scope: `make cert-check --pilot`-equivalent (`make cert-check
# PILOT=1`) refuses to pass without it. No other hostname setting exists
# in this project for this purpose -- do not add a second one.
WSS_PUBLIC_HOSTNAME=

# TASK-0015: dev-only PJSIP account for the local "provider" trunk
# simulator (docker/provider-config/pjsip.conf) -- never a real
# commercial carrier credential. Used both to configure the provider's
# own accepted account and, by scripts/trunk-smoke-test.sh, as the
# credentials the SENMA-side test trunk registers with.
TRUNK_TEST_USERNAME=senma-outbound
TRUNK_TEST_SECRET=change-me-for-local-development
