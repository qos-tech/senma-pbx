                <tr>
                  <td class="text-center"> <b> <?php echo $val['exten'] ?> </b> </td>
                  <td class="text-center"> <?php
                    $nameValue = explode("<", $val['name']);
                    $callerid = $nameValue[0];
                    echo $callerid ?>
                  </td>
                  <td class="text-center hidden-xs hidden-sm"> <?php echo $val['channel'] ?> </td>
                  <td class="text-center hidden-xs"> <?php echo $val['groups'] ?> </td>
