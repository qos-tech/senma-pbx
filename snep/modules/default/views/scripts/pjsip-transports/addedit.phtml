        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend><?php echo $this->translate('NAT / Advertised addresses');?></legend>

      <div class="form-group">
        <label class="col-sm-3 control-label"><?php echo $this->translate("Domain");?></label>
        <div class="col-sm-6">
          <input type="text" class="form-control" name="domain" value='<?php echo $this->escape($this->transport['domain']);?>'/>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label"><?php echo $this->translate("External Signaling Address");?></label>
        <div class="col-sm-6">
          <input type="text" class="form-control" name="external_signaling_address" value='<?php echo $this->escape($this->transport['external_signaling_address']);?>'/>
        </div>
      </div>

      <div class="form-group">
        <label class="col-sm-3 control-label"><?php echo $this->translate("External Signaling Port");?></label>
        <div class="col-sm-4">
