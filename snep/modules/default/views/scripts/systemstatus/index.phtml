<script type="text/javascript">
// TASK-0021: explicit Asterisk restart control. Bounded polling only --
// never one held-open request, never unbounded 1s hammering. See
// docs/tasks/0021-asterisk-operational-restart.md §9/§13.
(function() {
  var restartCsrfToken = "<?php echo $this->escape($this->restart_csrf_token); ?>";
  var restartBaseUrl = "<?php echo $this->baseUrl(); ?>/default/systemstatus";
  var pollTimer = null;
  var pollAttempts = 0;
  var pollInFlight = false;
  var POLL_INTERVAL_MS = 3000;
  var MAX_POLL_ATTEMPTS = 100; // ~5 minutes

  function applyState(state) {
    if (!state || !state.state) {
      return;
    }
    jQuery('#restartStateLabel').text(state.state);
    jQuery('#restartStateDetail').text(state.detail || '');
  }

  function stopPolling() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  function poll() {
    if (pollInFlight) {
      return;
    }
    pollInFlight = true;
    pollAttempts++;
    jQuery.getJSON(restartBaseUrl + '/restart-status')
      .done(function(state) {
        applyState(state);
        if (state.state === 'RUNNING' || state.state === 'ERROR') {
          stopPolling();
        }
      })
      .always(function() {
        pollInFlight = false;
        if (pollAttempts >= MAX_POLL_ATTEMPTS) {
          stopPolling();
          jQuery('#restartStateDetail').append(' (' + "<?php echo $this->translate('polling stopped -- refresh the page to check again'); ?>" + ')');
        }
      });
  }

  function startPolling() {
    stopPolling();
    pollAttempts = 0;
    poll();
    pollTimer = setInterval(poll, POLL_INTERVAL_MS);
  }

  jQuery('#btnShowGraceful').on('click', function() {
    jQuery('#restartConfirmNow').hide();
    jQuery('#restartConfirmGraceful').show();
  });
  jQuery('#btnShowNow').on('click', function() {
    jQuery('#restartConfirmGraceful').hide();
    jQuery('#restartConfirmNow').show();
  });
  jQuery('.restart-cancel-btn').on('click', function() {
    jQuery('.restart-confirm').hide();
  });

  jQuery('.restart-confirm-btn').on('click', function() {
    var mode = jQuery(this).data('mode');
    jQuery('.restart-confirm').hide();
    jQuery('#restartActions button').prop('disabled', true);
    jQuery.post(restartBaseUrl + '/restart-dispatch', { mode: mode, csrf_token: restartCsrfToken }, null, 'json')
      .done(function(resp) {
        if (resp && resp.csrf_token) {
          restartCsrfToken = resp.csrf_token;
        }
        if (resp && resp.result) {
          applyState({ state: resp.ok ? 'DISPATCHED' : 'ERROR', detail: resp.result.detail });
        }
        startPolling();
      })
      .fail(function() {
        jQuery('#restartStateDetail').text("<?php echo $this->translate('Failed to dispatch the restart request.'); ?>");
      })
      .always(function() {
        jQuery('#restartActions button').prop('disabled', false);
      });
  });

  <?php if (in_array($this->restart_state['state'], array('RESTART_PENDING', 'RECOVERING'), true)): ?>
  startPolling();
  <?php endif; ?>
})();
</script>
