<div class="row">
    
    <?php
    // TASK-0026G (Phase 11): "restore" added alongside the pre-existing
    // "removefile" override so SoundFilesController::restoreAction() can
    // reuse this same shared confirm partial instead of a near-duplicate
    // new file.
    if (in_array($this->remove_action, array('removefile', 'restore'), true)) {
        $action = $this->remove_action;
    }else{
        $action = 'remove';
    }
    ?>
	<form id="defaultForm" method="post" class="form-horizontal" action="<?php echo $this->url(array("controller" => $this->remove_form, "action" => $action), null, true); ?>" METHOD="post">
        <?php

        echo $this->action( 'sneperror', 'error', null, array('error_message' => $this->remove_message, 'error_type' => 'alert', 'error_title' => $this->remove_title, 'error_buttons' => False) );
        ?>

        <!-- TASK-0026G (F20): belt-and-suspenders alongside the global
             includes/javascript/csrf.js auto-injection -- this partial is
             a known shared choke point (delete/disable/enable/restore
             confirmations across the whole app), so the token is emitted
             directly rather than relying solely on JS. -->
        <input type="hidden" name="<?php echo Snep_Security_Csrf::FIELD; ?>" value="<?php echo $this->escape($this->csrfToken); ?>">
        <input type="hidden" name="id" value="<?php echo $this->id; ?>">

        <?php if(isset($this->name)){?>
            <input type="hidden" name="name" value="<?php echo $this->name; ?>">
        <?php } ?>

        <br>
        <div class="snep-body-footer-buttons">
            <button type="submit" class="btn btn-add" name="delete" value="Delete"><?php echo $this->translate("Delete");?></button>
            &nbsp;&nbsp;&nbsp;
        	<a class="btn btn-outline btn-add" href="javascript:window.history.go(-1)" role="button"><?php echo $this->translate("Cancel")?></a>
        </div>   
       
    	<br>
	</form>
</div>