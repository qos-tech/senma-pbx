    <?php if ($this->error_message): ?>
      <div class="alert alert-danger"><?php echo $this->error_message; ?></div>
    <?php endif; ?>

    <?php if ($this->action === "edit" && $this->usageCount > 0): ?>
      <div class="alert alert-warning">
        <?php echo $this->translate("This transport is used by %s extension(s)/trunk(s). Changes apply on the next reload.", $this->usageCount); ?>
      </div>
    <?php endif; ?>

    <fieldset>
      <legend><?php echo $this->translate('Transport');?></legend>

